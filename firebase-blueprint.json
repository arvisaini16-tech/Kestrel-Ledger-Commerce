        "eligibility": { "type": "string", "maxLength": 300 },
        "terms": { "type": "string", "maxLength": 600 },
        "features": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
