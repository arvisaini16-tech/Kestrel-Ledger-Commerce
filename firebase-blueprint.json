{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated platform user profile, verification status, and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "publicUserId": { "type": "string", "maxLength": 24, "pattern": "^UID[0-9]{3,}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "phoneVerified": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "photoURL": { "type": "string", "maxLength": 500 },
        "referralCode": { "type": "string", "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredBy": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "enum": ["active", "suspended", "flagged"] },
        "role": { "type": "string", "enum": ["user", "admin", "super_admin"] },
        "authMethod": { "type": "string", "enum": ["google", "email_otp", "mobile_otp"] },
        "twoFactorEnabled": { "type": "boolean" },
        "privacyProfileVisible": { "type": "boolean" },
        "privacyAnalyticsOptIn": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "status", "role", "createdAt", "updatedAt"]
    },
    "UserCounter": {
      "title": "UserCounter",
      "description": "Monotonic atomic counter generating sequential public User IDs (UID001, UID002, ...).",
      "type": "object",
      "properties": {
        "counterId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lastSeq": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["counterId", "lastSeq", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "RBAC administrator role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "support_staff", "read_only_staff"] },
        "permissions": { "type": "array" },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "permissions", "grantedBy", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Server-validated user coin wallet.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "availableCoins": { "type": "number" },
        "pendingCoins": { "type": "number" },
        "totalPurchasedCoins": { "type": "number" },
        "totalCreditedCoins": { "type": "number" },
        "totalDebitedCoins": { "type": "number" },
        "simulatedCommissionBalance": { "type": "number" },
        "lastTxId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "availableCoins", "pendingCoins", "totalPurchasedCoins", "simulatedCommissionBalance", "lastTxId", "updatedAt"]
    },
    "WalletLedgerEntry": {
      "title": "WalletLedgerEntry",
      "description": "Immutable coin transaction ledger entry.",
      "type": "object",
      "properties": {
        "txId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["credit", "debit", "plan_credit", "commission_sim", "refund", "adjustment"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
        "serverSignature": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["completed", "pending", "reversed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["txId", "userId", "type", "amount", "balanceAfter", "referenceId", "serverSignature", "description", "status", "createdAt"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Server-validated manual Admin Coin Management transaction (add or deduct) with idempotency lock.",
      "type": "object",
      "properties": {
        "txId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "idempotencyKey": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminEmail": { "type": "string", "maxLength": 160 },
        "action": { "type": "string", "enum": ["add", "deduct"] },
        "amount": { "type": "number" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "reason": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["txId", "idempotencyKey", "userId", "adminId", "adminEmail", "action", "amount", "balanceBefore", "balanceAfter", "reason", "status", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin audit log for coin additions, coin deductions, and withdrawal status changes.",
      "type": "object",
      "properties": {
        "auditId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminEmail": { "type": "string", "maxLength": 160 },
        "actionType": { "type": "string", "enum": ["COIN_ADD", "COIN_DEDUCT", "WITHDRAWAL_STATUS_UPDATE", "WITHDRAWAL_APPROVED", "WITHDRAWAL_REJECTED", "WITHDRAWAL_SUCCESSFUL", "WITHDRAWAL_FAILED", "ADMIN_USER_SEARCH", "USER_STATUS_UPDATED", "USER_IDS_MIGRATED"] },
        "targetUserId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetEntityId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "reason": { "type": "string", "maxLength": 400 },
        "payoutReferenceNumber": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["auditId", "adminId", "adminEmail", "actionType", "targetUserId", "targetEntityId", "amount", "reason", "payoutReferenceNumber", "details", "createdAt"]
    },
    "CoinPackage": {
      "title": "CoinPackage",
      "description": "Configurable coin purchase package.",
      "type": "object",
      "properties": {
        "packageId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "coinQuantity": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "description": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["active", "disabled", "archived"] },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["packageId", "name", "coinQuantity", "purchasePrice", "currency", "description", "status", "displayOrder", "createdAt", "updatedAt"]
    },
    "PlanConfig": {
      "title": "PlanConfig",
      "description": "Configurable coin-credit schedule plan.",
      "type": "object",
      "properties": {
        "planId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 140 },
        "purchasePrice": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "durationDays": { "type": "number" },
        "totalScheduledCredits": { "type": "number" },
        "creditIntervalHours": { "type": "number" },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["active", "disabled", "archived"] },
        "displayOrder": { "type": "number" },
        "availableFrom": { "type": "string", "maxLength": 64 },
        "availableUntil": { "type": "string", "maxLength": 64 },
        "terms": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["planId", "name", "purchasePrice", "currency", "durationDays", "totalScheduledCredits", "creditIntervalHours", "description", "status", "displayOrder", "availableFrom", "availableUntil", "terms", "createdAt", "updatedAt"]
    },
    "PlanPurchase": {
      "title": "PlanPurchase",
      "description": "Immutable snapshot of a user's purchased plan and 24-hour credit schedule state.",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planName": { "type": "string", "maxLength": 140 },
        "purchasePrice": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "durationDays": { "type": "number" },
        "totalScheduledCredits": { "type": "number" },
        "creditIntervalHours": { "type": "number" },
        "completedEvents": { "type": "number" },
        "totalEvents": { "type": "number" },
        "creditedCoinsSoFar": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled"] },
        "activatedAtIso": { "type": "string", "maxLength": 64 },
        "completesAtIso": { "type": "string", "maxLength": 64 },
        "nextCreditAtIso": { "type": "string", "maxLength": 64 },
        "termsSnapshot": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["purchaseId", "userId", "planId", "planName", "purchasePrice", "currency", "durationDays", "totalScheduledCredits", "creditIntervalHours", "completedEvents", "totalEvents", "creditedCoinsSoFar", "status", "activatedAtIso", "completesAtIso", "nextCreditAtIso", "termsSnapshot", "createdAt", "updatedAt"]
    },
    "PlanCreditScheduleEvent": {
      "title": "PlanCreditScheduleEvent",
      "description": "Individual 24-hour scheduled coin credit event with idempotency lock.",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "purchaseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dayIndex": { "type": "number" },
        "amountCoins": { "type": "number" },
        "scheduledAtIso": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "credited", "failed"] },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "ledgerTxId": { "type": "string", "maxLength": 128 },
        "creditedAtIso": { "type": "string", "maxLength": 64 }
      },
      "required": ["scheduleId", "purchaseId", "userId", "dayIndex", "amountCoins", "scheduledAtIso", "status", "idempotencyKey", "ledgerTxId", "creditedAtIso"]
    },
    "PaymentConfiguration": {
      "title": "PaymentConfiguration",
      "description": "Authorized merchant UPI configuration for backend random assignment.",
      "type": "object",
      "properties": {
        "configId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "maxLength": 120 },
        "upiId": { "type": "string", "maxLength": 120 },
        "merchantName": { "type": "string", "maxLength": 120 },
        "provider": { "type": "string", "maxLength": 80 },
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["SANDBOX_ONLY"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["configId", "label", "upiId", "merchantName", "provider", "enabled", "mode", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront hardware or membership item.",
