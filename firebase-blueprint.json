        "aiAdminDashboard": { "type": "boolean" },
        "aiFraudDetection": { "type": "boolean" },
        "aiSmartSuggestions": { "type": "boolean" },
        "aiHelpdesk": { "type": "boolean" },
        "aiVoiceAssistant": { "type": "boolean" },
        "multilingualAi": { "type": "boolean" },
        "aiBusinessIntelligence": { "type": "boolean" },
        "aiThemeDesigner": { "type": "boolean" },
        "smartNotificationEngine": { "type": "boolean" },
        "aiDatabaseHealthMonitor": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
