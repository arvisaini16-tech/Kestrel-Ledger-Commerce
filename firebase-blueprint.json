        "isSimulated": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentId", "userId", "userEmail", "idempotencyKey", "amountInr", "coinsRequested", "upiApp", "sandboxUpiId", "gatewayProvider", "status", "webhookEventId", "serverSignature", "failureReason", "isSimulated", "createdAt", "updatedAt"]
    },
    "CoinRequest": {
      "title": "CoinRequest",
