      "required": ["productId", "title", "description", "category", "itemType", "coinPrice", "inrPrice", "imageUrl", "active", "stock", "billingCycle", "eligibility", "terms", "features", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Product or plan purchase record.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productTitle": { "type": "string", "maxLength": 160 },
        "itemType": { "type": "string", "enum": ["product", "plan"] },
        "quantity": { "type": "number" },
        "coinAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "fulfilled", "refunded"] },
        "referenceId": { "type": "string", "maxLength": 128 },
        "serverSignature": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "userId", "productId", "productTitle", "itemType", "quantity", "coinAmount", "status", "referenceId", "serverSignature", "createdAt", "updatedAt"]
    },
    "SandboxPayment": {
      "title": "SandboxPayment",
